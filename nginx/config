ngx_addon_name=ngx_http_prometheus_module

# the http module: ngx_http_prometheus_module.so
ngx_module_type=HTTP
ngx_module_name=ngx_http_prometheus_module
ngx_module_incs=
ngx_module_srcs="$ngx_addon_dir/src/ngx_http_prometheus_module.c $ngx_addon_dir/src/ngx_http_prometheus_source.c $ngx_addon_dir/src/ngx_http_prometheus_listen.c $ngx_addon_dir/src/ngx_http_prometheus_label.c $ngx_addon_dir/src/ngx_http_prometheus_identity.c"
ngx_module_deps="$ngx_addon_dir/src/ngx_http_prometheus.h $ngx_addon_dir/src/ngx_prometheus_shared.h $ngx_addon_dir/src/ngx_http_prometheus_label.h $ngx_addon_dir/src/ngx_http_prometheus_identity.h"

. auto/module

# the stream module, its own .so so an nginx without stream can load the
# http one: ngx_stream_prometheus_module.so
if [ $STREAM != NO ]; then
    ngx_module_type=STREAM
    ngx_module_name=ngx_stream_prometheus_module
    ngx_module_incs=
    ngx_module_srcs="$ngx_addon_dir/src/ngx_stream_prometheus_module.c $ngx_addon_dir/src/ngx_http_prometheus_label.c"
    ngx_module_deps="$ngx_addon_dir/src/ngx_prometheus_shared.h $ngx_addon_dir/src/ngx_http_prometheus_label.h"

    . auto/module
fi
